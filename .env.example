# Copy to .env and fill in for your own deployment. Nothing in this repo
# ships with real credentials -- see README for local quickstart defaults.

# Vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=documents
QDRANT_LOCAL_PATH=./local_qdrant_data   # used when QDRANT_URL is unset (local/offline mode)
QDRANT_HNSW_M=32
QDRANT_HNSW_EF_CONSTRUCT=256
QDRANT_SEARCH_EF=128

# Embeddings
EMBEDDING_PROVIDER=hashing   # hashing | openai | sentence-transformers
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# LLM answer generation (optional -- falls back to extractive answers if unset)
LLM_PROVIDER=none           # none | openai
OPENAI_CHAT_MODEL=gpt-4o-mini

# Redis (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=300
CACHE_LOCK_TIMEOUT_SECONDS=10

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
